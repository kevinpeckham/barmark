# barmark environment schema — https://varlock.dev
#
# barmark's library and tests read no environment. This schema exists for
# local tooling only: the Swamp CLI needs a swamp-club credential, which
# lives in a 1Password environment and loads through the 1Password plugin.
# Run Swamp as:  bunx varlock run -- swamp workflow run release-check
# CI never loads this file (it runs the bun scripts directly).
#
# @defaultRequired=false @defaultSensitive=true
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_TOKEN, allowAppAuth=false)
# @setValuesBulk(opLoadEnvironment($OP_ENV_ID))
# ----------

# 1Password service-account token with read access to barmark's
# environment. Set in .env.local (gitignored); never commit it.
# @required @type=opServiceAccountToken
OP_TOKEN=

# The 1Password environment holding barmark's tooling secrets.
# Set in .env.local.
# @required @sensitive=false
OP_ENV_ID=

# swamp-club.com API token: authenticates the swamp CLI for the local
# release check. CLI-only; nothing in src/ reads it.
SWAMP_API_KEY=

# Signin proof issued alongside SWAMP_API_KEY (shown once at token
# creation): lets swamp work offline for a grace period. Optional.
SWAMP_SIGNIN_TOKEN=
