{
	"name": "@barmark/musicxml",
	"version": "0.1.1",
	"description": "Export barmark chord charts to MusicXML 4.0, several parts included, for MuseScore, Dorico, Sibelius and Finale.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"barmark",
		"chord-chart",
		"chords",
		"music",
		"musicxml",
		"lead-sheet",
		"converter"
	],
	"author": "Kevin Peckham",
	"license": "MIT",
	"homepage": "https://github.com/kevinpeckham/barmark/tree/main/packages/musicxml#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kevinpeckham/barmark.git",
		"directory": "packages/musicxml"
	},
	"bugs": {
		"url": "https://github.com/kevinpeckham/barmark/issues"
	},
	"dependencies": {
		"barmark": "workspace:^"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepack": "bun run build"
	}
}
