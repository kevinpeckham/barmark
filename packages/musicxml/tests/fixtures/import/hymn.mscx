<?xml version="1.0" encoding="UTF-8"?>
<!--
  A hymn written by hand for barmark's MusicXML round trips: a pickup,
  two verses, a melisma (an extension on "ing"), an elision in verse 2
  ("and‿I") and a note tied across a bar line.
  Copyright (c) 2026 Kevin Peckham. MIT licence, as the repository.
  scripts/musescore-fixtures.ts converts it with MuseScore 4.
-->
<museScore version="4.70">
  <Score>
    <Division>480</Division>
    <metaTag name="workTitle">Hymn</metaTag>
    <Part id="1">
      <Staff id="1"/>
      <trackName>Voice</trackName>
      <Instrument id="voice">
        <longName>Voice</longName>
        <shortName>Vo.</shortName>
        <instrumentId>voice.vocals</instrumentId>
      </Instrument>
    </Part>
    <Staff id="1">
      <VBox>
        <height>10</height>
        <Text><style>title</style><text>Hymn</text></Text>
      </VBox>
      <!-- 0 pickup: D4 -->
      <Measure len="1/4">
        <irregular>1</irregular>
        <voice>
          <KeySig><concertKey>1</concertKey></KeySig>
          <TimeSig><sigN>3</sigN><sigD>4</sigD></TimeSig>
          <Chord>
            <durationType>quarter</durationType>
            <Lyrics><syllabic>begin</syllabic><text>A</text></Lyrics>
            <Lyrics><no>1</no><text>'Twas</text></Lyrics>
            <Note><pitch>62</pitch><tpc>16</tpc></Note>
          </Chord>
        </voice>
      </Measure>
      <!-- 1 G: G4, B4 G4 (melisma on "ing") -->
      <Measure>
        <voice>
          <Harmony><harmonyInfo><root>15</root></harmonyInfo></Harmony>
          <Chord>
            <durationType>half</durationType>
            <Lyrics><syllabic>middle</syllabic><text>maz</text></Lyrics>
            <Lyrics><no>1</no><text>grace</text></Lyrics>
            <Note><pitch>67</pitch><tpc>15</tpc></Note>
          </Chord>
          <Chord>
            <durationType>eighth</durationType>
            <Lyrics><syllabic>end</syllabic><ticks_f>1/8</ticks_f><text>ing</text></Lyrics>
            <Lyrics><no>1</no><text>that</text></Lyrics>
            <Note><pitch>71</pitch><tpc>19</tpc></Note>
          </Chord>
          <Chord>
            <durationType>eighth</durationType>
            <Note><pitch>67</pitch><tpc>15</tpc></Note>
          </Chord>
        </voice>
      </Measure>
      <!-- 2 G G7: B4 A4 -->
      <Measure>
        <voice>
          <Harmony><harmonyInfo><root>15</root></harmonyInfo></Harmony>
          <Chord>
            <durationType>half</durationType>
            <Lyrics><text>grace</text></Lyrics>
            <Lyrics><no>1</no><text>taught</text></Lyrics>
            <Note><pitch>71</pitch><tpc>19</tpc></Note>
          </Chord>
          <Harmony><harmonyInfo><name>7</name><root>15</root></harmonyInfo></Harmony>
          <Chord>
            <durationType>quarter</durationType>
            <Lyrics><text>how</text></Lyrics>
            <Lyrics><no>1</no><text>my</text></Lyrics>
            <Note><pitch>69</pitch><tpc>17</tpc></Note>
          </Chord>
        </voice>
      </Measure>
      <!-- 3 C: G4 E4 (an elision in verse 2) -->
      <Measure>
        <voice>
          <Harmony><harmonyInfo><root>14</root></harmonyInfo></Harmony>
          <Chord>
            <durationType>half</durationType>
            <Lyrics><text>sweet</text></Lyrics>
            <Lyrics><no>1</no><text>heart</text></Lyrics>
            <Note><pitch>67</pitch><tpc>15</tpc></Note>
          </Chord>
          <Chord>
            <durationType>quarter</durationType>
            <Lyrics><text>the</text></Lyrics>
            <Lyrics><no>1</no><text>and<sym>lyricsElision</sym>I</text></Lyrics>
            <Note><pitch>64</pitch><tpc>18</tpc></Note>
          </Chord>
        </voice>
      </Measure>
      <!-- 4 G: D4, tied over the bar line -->
      <Measure>
        <voice>
          <Harmony><harmonyInfo><root>15</root></harmonyInfo></Harmony>
          <Chord>
            <dots>1</dots>
            <durationType>half</durationType>
            <Lyrics><text>sound</text></Lyrics>
            <Lyrics><no>1</no><text>fear</text></Lyrics>
            <Note>
              <Spanner type="Tie">
                <Tie/>
                <next><location><measures>1</measures></location></next>
              </Spanner>
              <pitch>62</pitch>
              <tpc>16</tpc>
            </Note>
          </Chord>
        </voice>
      </Measure>
      <!-- 5 D7: D4 held, then a rest -->
      <Measure>
        <voice>
          <Harmony><harmonyInfo><name>7</name><root>16</root></harmonyInfo></Harmony>
          <Chord>
            <durationType>half</durationType>
            <Note>
              <Spanner type="Tie">
                <prev><location><measures>-1</measures></location></prev>
              </Spanner>
              <pitch>62</pitch>
              <tpc>16</tpc>
            </Note>
          </Chord>
          <Rest><durationType>quarter</durationType></Rest>
          <BarLine><subtype>end</subtype></BarLine>
        </voice>
      </Measure>
    </Staff>
  </Score>
</museScore>
