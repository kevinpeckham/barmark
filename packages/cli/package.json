{
	"name": "@barmark/cli",
	"version": "0.10.2",
	"description": "The barmark command: check, format, render, transpose and export barmark chord charts (.chart.md) from the terminal and in CI.",
	"type": "module",
	"bin": {
		"barmark": "./dist/cli.js"
	},
	"exports": {
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=20.6"
	},
	"keywords": [
		"barmark",
		"chord-chart",
		"chords",
		"music",
		"cli",
		"formatter",
		"linter"
	],
	"author": "Kevin Peckham",
	"license": "MIT",
	"homepage": "https://www.barmark.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kevinpeckham/barmark.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/kevinpeckham/barmark/issues"
	},
	"dependencies": {
		"barmark": "workspace:*",
		"@barmark/render": "workspace:*",
		"@barmark/musicxml": "workspace:*",
		"@barmark/midi": "workspace:*",
		"@barmark/score": "workspace:*",
		"verovio": "6.4.1"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepack": "bun run build",
		"compile": "bun scripts/compile.ts"
	}
}
