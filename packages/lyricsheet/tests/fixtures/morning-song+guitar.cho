{title: Morning Song}
{key: G}
{time: 4/4}

{define: G base-fret 1 frets 3 2 0 0 0 3}
{define: C base-fret 1 frets x 3 2 0 1 0}
{define: D base-fret 1 frets x x 0 2 3 2}

{start_of_grid: label="Intro" shape="1+4x4+1"}
| G . . . | C . . . | G . . . | D . . . |
{end_of_grid}

{start_of_grid: label="Verse" shape="1+4x4+1"}
| G . . . | C . . . | G . . . | D . . . |
| G . . . | C . . . | D . . . | G . . . |
{end_of_grid}

{start_of_grid: label="Chorus" shape="1+4x4+1"}
|: C . . . | G . . . | D . . . | G . . . :|
{end_of_grid}
