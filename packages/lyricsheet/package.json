{
	"name": "@barmark/lyricsheet",
	"version": "0.0.0",
	"description": "Export a barmark chart as a ChordPro lyric sheet, and say what it could not carry.",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=20"
	},
	"keywords": [
		"barmark",
		"chord-chart",
		"chords",
		"music",
		"lyrics",
		"lyric-sheet",
		"chordpro"
	],
	"author": "Kevin Peckham",
	"license": "MIT",
	"homepage": "https://github.com/kevinpeckham/barmark/tree/main/packages/lyricsheet#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kevinpeckham/barmark.git",
		"directory": "packages/lyricsheet"
	},
	"bugs": {
		"url": "https://github.com/kevinpeckham/barmark/issues"
	},
	"dependencies": {
		"@barmark/fretboard": "workspace:^",
		"barmark": "workspace:^"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"prepack": "bun run build"
	}
}
