<?xml version="1.0" encoding="UTF-8"?>
<!--
  A band score written by hand for @barmark/midi's import tests: a guitar
  with chord symbols over slash notes that sound (as MuseScore plays a
  MusicXML file's slashes), a bass line with a slash-chord bass and a
  walk down, and a drum kit on channel 10. Two rehearsal marks.
  Copyright (c) 2026 Kevin Peckham. MIT licence, as the repository.
  scripts/midi-fixtures.ts converts it with MuseScore 4.
-->
