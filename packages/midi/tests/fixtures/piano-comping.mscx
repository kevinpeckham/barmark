<?xml version="1.0" encoding="UTF-8"?>
<!--
  A piano comping part written by hand for @barmark/midi's import tests:
  no chord symbols, so the harmony is read from the notes alone. Short
  left-hand bass notes and right-hand chords off the beat, held by the
  sustain pedal, which changes at each bar line and once inside bar 7.
  Copyright (c) 2026 Kevin Peckham. MIT licence, as the repository.
  scripts/midi-fixtures.ts converts it with MuseScore 4.
-->
<museScore version="4.70">
  <Score>
    <Division>480</Division>
    <metaTag name="workTitle">Pedal Comping</metaTag>
    <Part id="1">
      <Staff id="1">
        <bracket type="1" span="2" col="1" visible="1"/>
        <barLineSpan>1</barLineSpan>
      </Staff>
      <Staff id="2"/>
      <trackName>Piano</trackName>
      <Instrument id="piano">
        <longName>Piano</longName>
        <shortName>Pno.</shortName>
        <instrumentId>keyboard.piano</instrumentId>
        <clef staff="2">F</clef>
      </Instrument>
    </Part>
    <Staff id="1">
      <VBox>
        <height>10</height>
        <Text><style>title</style><text>Pedal Comping</text></Text>
      </VBox>
      <!-- 1 Fmaj7: A3 C4 E4 on beat one and the and of two -->
      <Measure>
        <voice>
          <KeySig><concertKey>-1</concertKey></KeySig>
          <TimeSig><sigN>4</sigN><sigD>4</sigD></TimeSig>
          <Tempo><tempo>1.4</tempo><followText>1</followText><text><sym>metNoteQuarterUp</sym> = 84</text></Tempo>
          <Chord><durationType>quarter</durationType><Note><pitch>57</pitch><tpc>17</tpc></Note><Note><pitch>60</pitch><tpc>14</tpc></Note><Note><pitch>64</pitch><tpc>18</tpc></Note></Chord>
          <Rest><durationType>eighth</durationType></Rest>
          <Chord><durationType>eighth</durationType><Note><pitch>57</pitch><tpc>17</tpc></Note><Note><pitch>60</pitch><tpc>14</tpc></Note><Note><pitch>64</pitch><tpc>18</tpc></Note></Chord>
          <Rest><durationType>half</durationType></Rest>
        </voice>
      </Measure>
      <!-- 2 Dm7: C4 F4 A4 -->
      <Measure>
        <voice>
          <Chord><durationType>quarter</durationType><Note><pitch>60</pitch><tpc>14</tpc></Note><Note><pitch>65</pitch><tpc>13</tpc></Note><Note><pitch>69</pitch><tpc>17</tpc></Note></Chord>
          <Rest><durationType>eighth</durationType></Rest>
          <Chord><durationType>eighth</durationType><Note><pitch>60</pitch><tpc>14</tpc></Note><Note><pitch>65</pitch><tpc>13</tpc></Note><Note><pitch>69</pitch><tpc>17</tpc></Note></Chord>
          <Rest><durationType>half</durationType></Rest>
        </voice>
      </Measure>
      <!-- 3 Gm7: Bb3 D4 F4 -->
      <Measure>
        <voice>
          <Chord><durationType>quarter</durationType><Note><pitch>58</pitch><tpc>12</tpc></Note><Note><pitch>62</pitch><tpc>16</tpc></Note><Note><pitch>65</pitch><tpc>13</tpc></Note></Chord>
          <Rest><durationType>eighth</durationType></Rest>
          <Chord><durationType>eighth</durationType><Note><pitch>58</pitch><tpc>12</tpc></Note><Note><pitch>62</pitch><tpc>16</tpc></Note><Note><pitch>65</pitch><tpc>13</tpc></Note></Chord>
          <Rest><durationType>half</durationType></Rest>
        </voice>
      </Measure>
      <!-- 4 C7: Bb3 E4 G4 -->
      <Measure>
        <voice>
          <Chord><durationType>quarter</durationType><Note><pitch>58</pitch><tpc>12</tpc></Note><Note><pitch>64</pitch><tpc>18</tpc></Note><Note><pitch>67</pitch><tpc>15</tpc></Note></Chord>
          <Rest><durationType>eighth</durationType></Rest>
          <Chord><durationType>eighth</durationType><Note><pitch>58</pitch><tpc>12</tpc></Note><Note><pitch>64</pitch><tpc>18</tpc></Note><Note><pitch>67</pitch><tpc>15</tpc></Note></Chord>
          <Rest><durationType>half</durationType></Rest>
        </voice>
      </Measure>
      <!-- 5 Am7: G3 C4 E4 -->
      <Measure>
        <voice>
          <Chord><durationType>quarter</durationType><Note><pitch>55</pitch><tpc>15</tpc></Note><Note><pitch>60</pitch><tpc>14</tpc></Note><Note><pitch>64</pitch><tpc>18</tpc></Note></Chord>
          <Rest><durationType>eighth</durationType></Rest>
          <Chord><durationType>eighth</durationType><Note><pitch>55</pitch><tpc>15</tpc></Note><Note><pitch>60</pitch><tpc>14</tpc></Note><Note><pitch>64</pitch><tpc>18</tpc></Note></Chord>
          <Rest><durationType>half</durationType></Rest>
        </voice>
      </Measure>
      <!-- 6 D7: F#4 A4 C5 -->
      <Measure>
        <voice>
          <Chord><durationType>quarter</durationType><Note><pitch>66</pitch><tpc>20</tpc></Note><Note><pitch>69</pitch><tpc>17</tpc></Note><Note><pitch>72</pitch><tpc>14</tpc></Note></Chord>
          <Rest><durationType>eighth</durationType></Rest>
          <Chord><durationType>eighth</durationType><Note><pitch>66</pitch><tpc>20</tpc></Note><Note><pitch>69</pitch><tpc>17</tpc></Note><Note><pitch>72</pitch><tpc>14</tpc></Note></Chord>
          <Rest><durationType>half</durationType></Rest>
        </voice>
      </Measure>
      <!-- 7 Gm7 C7: a chord on beats one and three -->
      <Measure>
        <voice>
          <Chord><durationType>quarter</durationType><Note><pitch>58</pitch><tpc>12</tpc></Note><Note><pitch>62</pitch><tpc>16</tpc></Note><Note><pitch>65</pitch><tpc>13</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
          <Chord><durationType>quarter</durationType><Note><pitch>58</pitch><tpc>12</tpc></Note><Note><pitch>64</pitch><tpc>18</tpc></Note><Note><pitch>67</pitch><tpc>15</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
        </voice>
      </Measure>
      <!-- 8 F6: A3 C4 D4 F4, held -->
      <Measure>
        <voice>
          <Chord><durationType>whole</durationType><Note><pitch>57</pitch><tpc>17</tpc></Note><Note><pitch>60</pitch><tpc>14</tpc></Note><Note><pitch>62</pitch><tpc>16</tpc></Note><Note><pitch>65</pitch><tpc>13</tpc></Note></Chord>
          <BarLine><subtype>end</subtype></BarLine>
        </voice>
      </Measure>
    </Staff>
    <Staff id="2">
      <!-- 1 F2, C3 -->
      <Measure>
        <voice>
          <KeySig><concertKey>-1</concertKey></KeySig>
          <TimeSig><sigN>4</sigN><sigD>4</sigD></TimeSig>
          <Spanner type="Pedal">
            <Pedal><endHookType>2</endHookType></Pedal>
            <next><location><measures>1</measures></location></next>
          </Spanner>
          <Chord><durationType>quarter</durationType><Note><pitch>41</pitch><tpc>13</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
          <Chord><durationType>quarter</durationType><Note><pitch>48</pitch><tpc>14</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
        </voice>
      </Measure>
      <!-- 2 D2, A2 -->
      <Measure>
        <voice>
          <Spanner type="Pedal"><prev><location><measures>-1</measures></location></prev></Spanner>
          <Spanner type="Pedal">
            <Pedal><beginHookType>2</beginHookType><endHookType>2</endHookType></Pedal>
            <next><location><measures>1</measures></location></next>
          </Spanner>
          <Chord><durationType>quarter</durationType><Note><pitch>38</pitch><tpc>16</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
          <Chord><durationType>quarter</durationType><Note><pitch>45</pitch><tpc>17</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
        </voice>
      </Measure>
      <!-- 3 G2, D3 -->
      <Measure>
        <voice>
          <Spanner type="Pedal"><prev><location><measures>-1</measures></location></prev></Spanner>
          <Spanner type="Pedal">
            <Pedal><beginHookType>2</beginHookType><endHookType>2</endHookType></Pedal>
            <next><location><measures>1</measures></location></next>
          </Spanner>
          <Chord><durationType>quarter</durationType><Note><pitch>43</pitch><tpc>15</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
          <Chord><durationType>quarter</durationType><Note><pitch>50</pitch><tpc>16</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
        </voice>
      </Measure>
      <!-- 4 C3, G2 -->
      <Measure>
        <voice>
          <Spanner type="Pedal"><prev><location><measures>-1</measures></location></prev></Spanner>
          <Spanner type="Pedal">
            <Pedal><beginHookType>2</beginHookType><endHookType>2</endHookType></Pedal>
            <next><location><measures>1</measures></location></next>
          </Spanner>
          <Chord><durationType>quarter</durationType><Note><pitch>48</pitch><tpc>14</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
          <Chord><durationType>quarter</durationType><Note><pitch>43</pitch><tpc>15</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
        </voice>
      </Measure>
      <!-- 5 A2, E3 -->
      <Measure>
        <voice>
          <Spanner type="Pedal"><prev><location><measures>-1</measures></location></prev></Spanner>
          <Spanner type="Pedal">
            <Pedal><beginHookType>2</beginHookType><endHookType>2</endHookType></Pedal>
            <next><location><measures>1</measures></location></next>
          </Spanner>
          <Chord><durationType>quarter</durationType><Note><pitch>45</pitch><tpc>17</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
          <Chord><durationType>quarter</durationType><Note><pitch>52</pitch><tpc>18</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
        </voice>
      </Measure>
      <!-- 6 D2, A2 -->
      <Measure>
        <voice>
          <Spanner type="Pedal"><prev><location><measures>-1</measures></location></prev></Spanner>
          <Spanner type="Pedal">
            <Pedal><beginHookType>2</beginHookType><endHookType>2</endHookType></Pedal>
            <next><location><measures>1</measures></location></next>
          </Spanner>
          <Chord><durationType>quarter</durationType><Note><pitch>38</pitch><tpc>16</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
          <Chord><durationType>quarter</durationType><Note><pitch>45</pitch><tpc>17</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
        </voice>
      </Measure>
      <!-- 7 G2, then C3 with the pedal changed on beat three -->
      <Measure>
        <voice>
          <Spanner type="Pedal"><prev><location><measures>-1</measures></location></prev></Spanner>
          <Spanner type="Pedal">
            <Pedal><beginHookType>2</beginHookType><endHookType>2</endHookType></Pedal>
            <next><location><fractions>1/2</fractions></location></next>
          </Spanner>
          <Chord><durationType>quarter</durationType><Note><pitch>43</pitch><tpc>15</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
          <Spanner type="Pedal"><prev><location><fractions>-1/2</fractions></location></prev></Spanner>
          <Spanner type="Pedal">
            <Pedal><beginHookType>2</beginHookType><endHookType>2</endHookType></Pedal>
            <next><location><fractions>1/2</fractions></location></next>
          </Spanner>
          <Chord><durationType>quarter</durationType><Note><pitch>48</pitch><tpc>14</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
        </voice>
      </Measure>
      <!-- 8 F2, held, the pedal lifted at the end -->
      <Measure>
        <voice>
          <Spanner type="Pedal"><prev><location><fractions>-1/2</fractions></location></prev></Spanner>
          <Spanner type="Pedal">
            <Pedal><beginHookType>2</beginHookType><endHookType>1</endHookType></Pedal>
            <next><location><measures>1</measures></location></next>
          </Spanner>
          <Chord><durationType>quarter</durationType><Note><pitch>41</pitch><tpc>13</tpc></Note></Chord>
          <Rest><durationType>quarter</durationType></Rest>
          <Rest><durationType>half</durationType></Rest>
          <Spanner type="Pedal"><prev><location><measures>-1</measures></location></prev></Spanner>
          <BarLine><subtype>end</subtype></BarLine>
        </voice>
      </Measure>
    </Staff>
  </Score>
</museScore>
