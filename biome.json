{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!packages/*/tests/fixtures",
			"!**/*.md",
			"!.swamp.yaml",
			"!.fallow-health-baseline.json",
			"!extensions",
			"!models",
			"!workflows",
			"!site/.svelte-kit",
			"!site/.vercel",
			"!site/static/fonts"
		]
	},
	"formatter": { "indentStyle": "tab", "lineWidth": 100 },
	"overrides": [
		{ "includes": [".fallowrc.json"], "json": { "parser": { "allowComments": true } } },
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"style": { "useConst": "off", "useImportType": "off" },
					"correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" }
				}
			}
		}
	]
}
