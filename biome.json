{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"includes": [
			"**",
			"!tests/fixtures",
			"!**/*.md",
			"!.swamp.yaml",
			"!.fallow-health-baseline.json",
			"!extensions",
			"!models",
			"!workflows"
		]
	},
	"formatter": { "indentStyle": "tab", "lineWidth": 100 },
	"overrides": [{ "includes": [".fallowrc.json"], "json": { "parser": { "allowComments": true } } }]
}
