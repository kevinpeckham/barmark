{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowImportingTsExtensions": false,
		"verbatimModuleSyntax": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["bun"],
		"lib": ["ESNext", "DOM"],
		"paths": { "barmark": ["./packages/barmark/src/index.ts"] }
	},
	"include": ["packages/*/src", "packages/*/tests", "packages/*/browser", "scripts"]
}
