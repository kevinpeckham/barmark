{
	// This file is JSONC: fallow reads these comments; generic JSON tools may not.
	"$schema": "./node_modules/fallow/schema.json",
	// The scripts and tests run on their own; package.json's exports names src's entry.
	"entry": ["scripts/**/*.ts", "tests/**/*.test.ts"],
	// extensions/ holds Swamp behavior types: Deno code with npm: specifiers, run by Swamp's own runtime.
	"ignorePatterns": ["extensions/**", ".swamp/**"],
	// Complexity as it stood at 0.1.0 (FINDINGS.md). A new finding, or a file that gets worse, fails.
	"audit": { "healthBaseline": ".fallow-health-baseline.json" },
	"rules": {}
}
