{
	// This file is JSONC: fallow reads these comments; generic JSON tools may not.
	"$schema": "./node_modules/fallow/schema.json",
	// The scripts and tests run on their own; each package.json's exports names its src entry.
	"entry": [
		"scripts/**/*.{ts,mjs}",
		"packages/*/tests/**/*.test.ts",
		"packages/*/browser/*.{ts,pw.ts}",
		// The CLI's standalone-binary entry and its compile script, run by Bun rather than imported.
		"packages/cli/src/binary.ts",
		"packages/cli/scripts/*.ts"
	],
	// extensions/ holds Swamp behavior types: Deno code with npm: specifiers, run by Swamp's own runtime.
	// site/ is its own SvelteKit project (Fallow does not model its routes); svelte-check and its tests cover it.
	"ignorePatterns": ["extensions/**", ".swamp/**", "site/**"],
	// @barmark/score depends on @barmark/render for its server markup and element (plan tasks 4-5); drop this once they import it.
	"ignoreDependencies": ["@barmark/render"],
	// Complexity as it stood at 0.1.0 (FINDINGS.md). A new finding, or a file that gets worse, fails.
	"audit": { "healthBaseline": ".fallow-health-baseline.json" },
	"rules": {}
}
